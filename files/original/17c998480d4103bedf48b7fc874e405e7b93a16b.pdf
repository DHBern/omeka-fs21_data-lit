    xmlns:plus="http://ns.useplus.org/ldf/xmp/1.0/"
   photoshop:Category="I"
   photoshop:Source="AFP"
   photoshop:City="Damascus"
   photoshop:AuthorsPosition="Contributor"
   photoshop:CopyrightFlag="true"
   photoshop:Country="Syria"
   photoshop:DateCreated="2020-06-16T00:00:00+00:00"
   photoshop:Credit="AFP via Getty Images"
   photoshop:Headline="SYRIA-CONFLICT-US-SANCTIONS"
